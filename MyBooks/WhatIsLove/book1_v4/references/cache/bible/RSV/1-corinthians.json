        "url": "https://www.biblestudytools.com/rsv/1-corinthians/5.html",
        "date": "2026-09-29"
      }
    ],
    "notes": ""
  },
  "5:6": {
    "text": "Your boasting is not good. Do you not know that a little leaven leavens the whole lump?",
    "status": "verified",
    "sources": [
      {
        "url": "https://www.biblestudytools.com/rsv/1-corinthians/5.html",
        "date": "2026-09-29"
